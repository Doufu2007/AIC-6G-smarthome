# Example configuration only. Do not put real tokens in this tracked file.
SENSEHOME_UPSTREAM_URL=http://127.0.0.1:8000/v1
SENSEHOME_MODEL=sensehome-large
SENSEHOME_MODEL_REVISION=unknown
SENSEHOME_UPSTREAM_TIMEOUT_S=60
SENSEHOME_WRAPPER_HOST=127.0.0.1
SENSEHOME_WRAPPER_PORT=18091
SENSEHOME_TIER=cloud
SENSEHOME_MAX_TOKENS=512
SENSEHOME_MAX_INFLIGHT=2
# Set SENSEHOME_GPU_INFO from an actual nvidia-smi observation at deployment.
# SENSEHOME_API_KEY is optional for loopback vLLM; inject privately if required.
# SENSEHOME_WRAPPER_TOKEN is optional. The existing dashboard expects an SSH
# tunnel with a loopback wrapper and no wrapper-level token.
